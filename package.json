{
  "name": "parh-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check-copy && npm run check-diagnostico && next build",
    "check-diagnostico": "node scripts/check-diagnostico.mts",
    "build:only": "next build",
    "start": "next start",
    "lint": "eslint",
    "check-copy": "node scripts/check-copy.mjs",
    "placeholders": "node scripts/placeholders.mjs",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/optimize-images.mjs",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "15.5.22",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.84.0",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "glob": "^13.0.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
